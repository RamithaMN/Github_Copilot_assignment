{
  "mcpServers": {
    "github": {
      "description": "Scoped GitHub metadata and label operations for the assignment demo.",
      "requiredEnvironment": ["GITHUB_TOKEN"],
      "allowedOperations": [
        "list_pull_requests",
        "pull_request_read",
        "issue_read",
        "issue_write",
        "label_write"
      ],
      "writeApprovalRequired": true
    }
  }
}
